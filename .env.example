PORT=3000
BUSINESS_CONFIG_PATH=config/business.json

# Meta WhatsApp Cloud API
WHATSAPP_VERIFY_TOKEN=replace-with-a-random-secret
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v25.0

# Optional. Without this key, the agent uses deterministic FAQ matching.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5

# Optional secure availability source. Keep service account JSON server-side only.
CALENDLY_ACCESS_TOKEN=
CALENDLY_USER_URI=

# Optional alternate secure availability source. Keep service account JSON server-side only.
GOOGLE_CALENDAR_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=

# Optional manual/local blocked dates for testing or fallback, comma-separated YYYY-MM-DD.
ANTARA_AKAD_BLOCKED_DATES=2026-12-12
